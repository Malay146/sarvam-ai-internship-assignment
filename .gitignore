# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw third-party site source dumps (kept locally; extracted findings are committed)
/references/brand-css/*.html
/references/brand-css/*.js
/references/brand-css/*.css

# Sarvam's own images (logos, brand images, site screenshots, social posts): kept locally as research,
# not republished. What we took from them is in references/brand-findings.md and references/social/README.md.
/references/brand/
/references/site/
/references/social/*
!/references/social/README.md
